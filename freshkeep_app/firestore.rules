rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(householdId) {
      return signedIn()
        && isActiveHousehold(householdId)
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isActiveHousehold(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId))
        && (!('archivedAt' in get(/databases/$(database)/documents/households/$(householdId)).data)
          || get(/databases/$(database)/documents/households/$(householdId)).data.archivedAt == null);
    }

    function isOwner(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, update, delete: if isUser(userId);
      allow create: if isUser(userId);

      match /inventory/{itemId} {
        allow read, write: if isUser(userId);
      }

      match /shoppingList/{itemId} {
        allow read, write: if isUser(userId);
      }

      match /preferences/{preferenceId} {
        allow read, write: if isUser(userId);
      }

      match /savedRecipes/{recipeId} {
        allow read, write: if isUser(userId);
      }

      match /householdState/{stateId} {
        allow read, write: if isUser(userId);
      }

      // Membership indexes are created alongside the corresponding member
      // document. getAfter() prevents a user from inventing an index entry.
      match /households/{householdId} {
        allow read: if isUser(userId);
        // This is only a private index for the signed-in user's households.
        // The household and membership documents may be written in separate
        // requests, so do not require a particular write ordering here.
        allow create: if isUser(userId);
        allow delete: if isUser(userId);
      }
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if signedIn()
        // The repository creates the household document before its member
        // document. Keep creation owner-scoped, then authorize the member
        // write separately below.
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(householdId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode;
      allow delete: if isOwner(householdId);

      match /members/{memberUid} {
        allow read: if isMember(householdId);
        allow create: if signedIn()
          && request.auth.uid == memberUid
          && (
            // The owner is created together with the household document.
            getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid
            || (
              // A new member must prove both the invite code and its
              // matching household password hash. No household data is
              // exposed by this invite document.
              request.resource.data.uid == memberUid
              && request.resource.data.inviteCode is string
              && request.resource.data.passwordHash is string
              && exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode))
              && request.resource.data.passwordHash == get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.passwordHash
              && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.householdId == householdId
            )
          );
        allow delete: if isOwner(householdId) || (signedIn() && request.auth.uid == memberUid);
        allow update: if isOwner(householdId);
      }

      match /inventory/{itemId} {
        allow read, write: if isMember(householdId);
      }

      match /shoppingList/{itemId} {
        allow read, write: if isMember(householdId);
      }
    }

    // Invite metadata contains only a household ID and a password hash; it
    // never contains inventory or member data. It is readable only by signed-
    // in users so the join flow can validate the password before membership.
    match /householdInvites/{inviteCode} {
      // Invite documents contain only a household id and a one-way password
      // hash. They are not household data, so authenticated users may read a
      // code to validate a join. Inventory and member data remains protected
      // by the household membership rules below.
      allow read: if signedIn();
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.ownerUid == request.auth.uid;
    }
  }
}
